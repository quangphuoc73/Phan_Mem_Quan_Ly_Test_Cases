{
  "name": "ai-testcase-manager",
  "version": "1.0.0",
  "description": "Hệ thống quản lý test case có hỗ trợ AI – Đồ án SE104 Nhập môn Công nghệ phần mềm (UIT)",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/db/seed.js",
    "reset": "node src/db/seed.js --reset",
    "test": "node --test tests/unit/*.test.js tests/api/*.test.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:api": "node --test tests/api/*.test.js",
    "test:e2e": "playwright test -c e2e/playwright.config.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "11.10.0",
    "chart.js": "^4.5.1",
    "dotenv": "^18.0.8",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "supertest": "^7.3.1"
  }
}
