# Sao chép thành .env rồi điền giá trị. KHÔNG commit file .env lên GitHub.
PORT=3000
# Chuỗi bí mật ký JWT – đổi thành chuỗi ngẫu nhiên dài khi triển khai
JWT_SECRET=doi-chuoi-bi-mat-nay
JWT_EXPIRES_IN=8h

# Chọn AI: mock (offline, không cần key) | gemini | claude | openai
AI_PROVIDER=mock
MOCK_DELAY_MS=1500

# Gemini (có gói miễn phí): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Claude: https://console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Đồng bộ dự án từ Jira Cloud (YC13). Để trống JIRA_BASE_URL thì dùng Jira giả lập (dự án mẫu HRM, LIB)
# API token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
# Webhook: Jira gọi POST http(s)://<địa chỉ app>/api/jira/webhook?secret=<mã này> khi story thay đổi (cần địa chỉ công khai, VD ngrok)
JIRA_WEBHOOK_SECRET=
# Đồng bộ định kỳ (phút), 0 = tắt
JIRA_SYNC_MINUTES=5

# Worker chạy Playwright (YC10). PW_CHANNEL=chromium khi chạy trong Docker/CI
RUNNER_ENABLED=true
# PW_CHANNEL=chromium
# Chạy ngầm khi phát triển. Lúc demo cho hội đồng xem: HEADED=1 và SLOW_MO=300
HEADED=1
