# Sao chép thành .env rồi điền giá trị. KHÔNG commit file .env lên GitHub.
PORT=3000
# Chuỗi bí mật ký JWT – đổi thành chuỗi ngẫu nhiên dài khi triển khai
JWT_SECRET=doi-chuoi-bi-mat-nay
JWT_EXPIRES_IN=8h

# Chọn AI: mock (offline, không cần key) | gemini | claude | openai
AI_PROVIDER=mock
MOCK_DELAY_MS=1500

# Gemini (có gói miễn phí): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Claude: https://console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Worker chạy Playwright (YC9). PW_CHANNEL=chromium khi chạy trong Docker/CI
RUNNER_ENABLED=true
# PW_CHANNEL=chromium
# Chạy ngầm khi phát triển. Lúc demo cho hội đồng xem: HEADED=1 và SLOW_MO=300
HEADED=1
