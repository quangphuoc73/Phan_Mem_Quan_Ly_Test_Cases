<mxfile host="generate_dfd.py" agent="SE104 AI TestCase Manager" version="24.0.0"><diagram id="p1" name="DFD YC2 – Sinh test case bằng AI"><mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1500" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;DFD YC2 – Sinh test case bằng AI&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Times New Roman;fontSize=30;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1500" height="50" as="geometry"/></mxCell><mxCell id="c3" value="QA Lead, Tester" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1046A8;strokeColor=#000000;strokeWidth=3;fontFamily=Times New Roman;fontSize=26;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="590" y="90" width="420" height="90" as="geometry"/></mxCell><mxCell id="c4" value="Sinh test case bằng AI" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1046A8;strokeColor=#000000;strokeWidth=3;fontFamily=Times New Roman;fontSize=26;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="610" y="370" width="380" height="130" as="geometry"/></mxCell><mxCell id="c5" value="Dịch vụ LLM" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1046A8;strokeColor=#000000;strokeWidth=3;fontFamily=Times New Roman;fontSize=26;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="390" width="420" height="90" as="geometry"/></mxCell><mxCell id="c6" value="Dịch vụ LLM" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1046A8;strokeColor=#000000;strokeWidth=3;fontFamily=Times New Roman;fontSize=26;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1160" y="390" width="420" height="90" as="geometry"/></mxCell><mxCell id="c7" value="Bộ nhớ phụ" style="shape=partialRectangle;whiteSpace=wrap;html=1;left=0;right=0;fillColor=none;strokeColor=#000000;strokeWidth=4;fontFamily=Times New Roman;fontSize=26;" vertex="1" parent="1"><mxGeometry x="600" y="690" width="400" height="90" as="geometry"/></mxCell><mxCell id="c8" value="" style="shape=singleArrow;direction=south;whiteSpace=wrap;html=1;arrowWidth=0.42;arrowSize=0.28;fillColor=#8C9524;strokeColor=#4D5214;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="730" y="182" width="46" height="190" as="geometry"/></mxCell><mxCell id="c9" value="D1" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="660" y="255" width="60" height="40" as="geometry"/></mxCell><mxCell id="c10" value="" style="shape=singleArrow;direction=north;whiteSpace=wrap;html=1;arrowWidth=0.42;arrowSize=0.28;fillColor=#8C9524;strokeColor=#4D5214;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="824" y="182" width="46" height="190" as="geometry"/></mxCell><mxCell id="c11" value="D6" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="880" y="255" width="60" height="40" as="geometry"/></mxCell><mxCell id="c12" value="" style="shape=singleArrow;direction=east;whiteSpace=wrap;html=1;arrowWidth=0.42;arrowSize=0.28;fillColor=#8C9524;strokeColor=#4D5214;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="445" y="410" width="168" height="50" as="geometry"/></mxCell><mxCell id="c13" value="D2" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="495" y="360" width="60" height="40" as="geometry"/></mxCell><mxCell id="c14" value="" style="shape=singleArrow;direction=east;whiteSpace=wrap;html=1;arrowWidth=0.42;arrowSize=0.28;fillColor=#8C9524;strokeColor=#4D5214;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="990" y="410" width="168" height="50" as="geometry"/></mxCell><mxCell id="c15" value="D5" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1040" y="360" width="60" height="40" as="geometry"/></mxCell><mxCell id="c16" value="" style="shape=singleArrow;direction=north;whiteSpace=wrap;html=1;arrowWidth=0.42;arrowSize=0.28;fillColor=#8C9524;strokeColor=#4D5214;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="730" y="498" width="46" height="190" as="geometry"/></mxCell><mxCell id="c17" value="D3" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="660" y="575" width="60" height="40" as="geometry"/></mxCell><mxCell id="c18" value="" style="shape=singleArrow;direction=south;whiteSpace=wrap;html=1;arrowWidth=0.42;arrowSize=0.28;fillColor=#8C9524;strokeColor=#4D5214;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="824" y="498" width="46" height="190" as="geometry"/></mxCell><mxCell id="c19" value="D4" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="880" y="575" width="60" height="40" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Biểu mẫu:&lt;/b&gt; BM2 &amp;nbsp; &lt;b&gt;Quy định:&lt;/b&gt; QĐ2&lt;br&gt;&lt;br&gt;&lt;b&gt;D1:&lt;/b&gt; Requirement cần sinh test case.&lt;br&gt;&lt;b&gt;D2:&lt;/b&gt; Chuỗi JSON danh sách test case do LLM trả về, mỗi test có danh sách AC liên quan (ac_refs).&lt;br&gt;&lt;b&gt;D3:&lt;/b&gt; Nội dung requirement (tiêu đề, mô tả, AC đánh số); trạng thái lưu trữ, Cần kiểm tra; số test hiện có; tham số MAX_TC_PER_STORY, MIN_AC_PER_STORY, AI_MAX_RETRY, AI_TIMEOUT_SEC, AI_CALLS_PER_HOUR; số lần gọi AI của người dùng trong 1 giờ.&lt;br&gt;&lt;b&gt;D4:&lt;/b&gt; Test case mới (nguồn AI, Nháp, phiên bản 1, phiên bản requirement đã liên kết) cùng liên kết AC; nhật ký AI (prompt đã che dữ liệu, kết quả gốc, số lần thử, cờ injection).&lt;br&gt;&lt;b&gt;D5:&lt;/b&gt; Prompt gửi LLM: vai trò QA, quy định QĐ2, requirement ĐÃ CHE dữ liệu nhạy cảm, AC được đánh số.&lt;br&gt;&lt;b&gt;D6:&lt;/b&gt; Danh sách test case Nháp vừa sinh kèm AC liên quan, số test bị bỏ do vượt giới hạn, cảnh báo prompt injection; hoặc thông báo lỗi.&lt;br&gt;&lt;br&gt;&lt;b&gt;Thuật toán:&lt;/b&gt;&lt;br&gt;B1: Nhận D1 từ người dùng.&lt;br&gt;B2: Kết nối cơ sở dữ liệu.&lt;br&gt;B3: Đọc D3 từ bộ nhớ phụ.&lt;br&gt;B4: Kiểm tra số lần gọi AI trong 1 giờ &amp;lt; AI_CALLS_PER_HOUR (dùng chung cho YC2, YC15, YC17)? Nếu không thỏa: ghi thông báo lỗi vào D6, chuyển tới B11.&lt;br&gt;B5: Kiểm tra requirement chưa lưu trữ, không Cần kiểm tra và có ít nhất MIN_AC_PER_STORY AC? Nếu không thỏa: ghi thông báo lỗi vào D6, chuyển tới B11.&lt;br&gt;B6: Tính số test còn được sinh = MAX_TC_PER_STORY − số test hiện có. Kiểm tra số này &amp;gt; 0? Nếu không thỏa: ghi thông báo lỗi vào D6, chuyển tới B11.&lt;br&gt;B7: Che dữ liệu nhạy cảm và đánh dấu nếu phát hiện prompt injection; ghép prompt, xuất D5 đến LLM, chờ tối đa AI_TIMEOUT_SEC giây.&lt;br&gt;B8: Nhận D2. Nếu sai JSON schema (thiếu ac_refs, sai số bước…) thì gọi lại, tối đa AI_MAX_RETRY lần; quá số lần vẫn sai? Nếu không thỏa: ghi thông báo lỗi vào D6, chuyển tới B11.&lt;br&gt;B9: Cắt danh sách theo số test còn được sinh; giữ nguyên bản nháp cũ (không thay thế); đổi ac_refs thành nội dung AC để liên kết.&lt;br&gt;B10: Lưu D4 xuống bộ nhớ phụ.&lt;br&gt;B11: Xuất D6 cho người dùng.&lt;br&gt;B12: Đóng kết nối cơ sở dữ liệu.&lt;br&gt;B13: Kết thúc." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Times New Roman;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="810" width="1520" height="700" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
