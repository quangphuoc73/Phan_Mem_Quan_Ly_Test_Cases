<mxfile host="generate_dfd.py" agent="SE104 AI TestCase Manager" version="24.0.0"><diagram id="p1" name="DFD YC8 – Nhận thay đổi requirement từ Jira"><mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1500" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;DFD YC8 – Nhận thay đổi requirement từ Jira&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Times New Roman;fontSize=30;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1500" height="50" as="geometry"/></mxCell><mxCell id="c3" value="Admin, QA Lead" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1046A8;strokeColor=#000000;strokeWidth=3;fontFamily=Times New Roman;fontSize=26;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="590" y="90" width="420" height="90" as="geometry"/></mxCell><mxCell id="c4" value="Nhận thay đổi requirement" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1046A8;strokeColor=#000000;strokeWidth=3;fontFamily=Times New Roman;fontSize=26;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="610" y="370" width="380" height="130" as="geometry"/></mxCell><mxCell id="c5" value="Jira (webhook, REST API)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1046A8;strokeColor=#000000;strokeWidth=3;fontFamily=Times New Roman;fontSize=26;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="390" width="420" height="90" as="geometry"/></mxCell><mxCell id="c6" value="Jira (REST API)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1046A8;strokeColor=#000000;strokeWidth=3;fontFamily=Times New Roman;fontSize=26;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1160" y="390" width="420" height="90" as="geometry"/></mxCell><mxCell id="c7" value="Bộ nhớ phụ" style="shape=partialRectangle;whiteSpace=wrap;html=1;left=0;right=0;fillColor=none;strokeColor=#000000;strokeWidth=4;fontFamily=Times New Roman;fontSize=26;" vertex="1" parent="1"><mxGeometry x="600" y="690" width="400" height="90" as="geometry"/></mxCell><mxCell id="c8" value="" style="shape=singleArrow;direction=south;whiteSpace=wrap;html=1;arrowWidth=0.42;arrowSize=0.28;fillColor=#8C9524;strokeColor=#4D5214;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="730" y="182" width="46" height="190" as="geometry"/></mxCell><mxCell id="c9" value="D1" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="660" y="255" width="60" height="40" as="geometry"/></mxCell><mxCell id="c10" value="" style="shape=singleArrow;direction=north;whiteSpace=wrap;html=1;arrowWidth=0.42;arrowSize=0.28;fillColor=#8C9524;strokeColor=#4D5214;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="824" y="182" width="46" height="190" as="geometry"/></mxCell><mxCell id="c11" value="D6" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="880" y="255" width="60" height="40" as="geometry"/></mxCell><mxCell id="c12" value="" style="shape=singleArrow;direction=east;whiteSpace=wrap;html=1;arrowWidth=0.42;arrowSize=0.28;fillColor=#8C9524;strokeColor=#4D5214;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="445" y="410" width="168" height="50" as="geometry"/></mxCell><mxCell id="c13" value="D2" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="495" y="360" width="60" height="40" as="geometry"/></mxCell><mxCell id="c14" value="" style="shape=singleArrow;direction=east;whiteSpace=wrap;html=1;arrowWidth=0.42;arrowSize=0.28;fillColor=#8C9524;strokeColor=#4D5214;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="990" y="410" width="168" height="50" as="geometry"/></mxCell><mxCell id="c15" value="D5" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1040" y="360" width="60" height="40" as="geometry"/></mxCell><mxCell id="c16" value="" style="shape=singleArrow;direction=north;whiteSpace=wrap;html=1;arrowWidth=0.42;arrowSize=0.28;fillColor=#8C9524;strokeColor=#4D5214;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="730" y="498" width="46" height="190" as="geometry"/></mxCell><mxCell id="c17" value="D3" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="660" y="575" width="60" height="40" as="geometry"/></mxCell><mxCell id="c18" value="" style="shape=singleArrow;direction=south;whiteSpace=wrap;html=1;arrowWidth=0.42;arrowSize=0.28;fillColor=#8C9524;strokeColor=#4D5214;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="824" y="498" width="46" height="190" as="geometry"/></mxCell><mxCell id="c19" value="D4" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="880" y="575" width="60" height="40" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Biểu mẫu:&lt;/b&gt; BM7 &amp;nbsp; &lt;b&gt;Quy định:&lt;/b&gt; QĐ8&lt;br&gt;&lt;br&gt;&lt;b&gt;D1:&lt;/b&gt; Thao tác Đồng bộ ngay; hoặc quyết định Lưu trữ / Giữ lại cho requirement Cần kiểm tra.&lt;br&gt;&lt;b&gt;D2:&lt;/b&gt; Từ Jira: sự kiện webhook kèm mã bí mật, hoặc lượt đồng bộ định kỳ; nội dung issue lấy lại qua REST API; kết quả hỏi lại từng issue ID.&lt;br&gt;&lt;b&gt;D3:&lt;/b&gt; JIRA_WEBHOOK_SECRET, JIRA_SYNC_MINUTES, JIRA_ISSUE_TYPES; requirement đã lưu (issue ID, thời điểm cập nhật Jira, nội dung, phiên bản); test và AC liên kết của requirement.&lt;br&gt;&lt;b&gt;D4:&lt;/b&gt; Phiên bản requirement mới; cờ Cần xem lại của test (lý do AC đổi / AC bị bỏ / tiêu đề, mô tả đổi); cờ Cần kiểm tra kèm lý do; quyết định Lưu trữ / Giữ lại; nhật ký đồng bộ (nguồn, thời điểm, kết quả, lỗi); nhật ký hoạt động.&lt;br&gt;&lt;b&gt;D5:&lt;/b&gt; Yêu cầu đọc issue qua Jira REST API (không dùng dữ liệu trong webhook); hỏi lại theo issue ID với requirement biến mất.&lt;br&gt;&lt;b&gt;D6:&lt;/b&gt; Kết quả đồng bộ (BM7): số requirement cập nhật, phiên bản mới, test bị gắn cờ, Cần kiểm tra; trạng thái và lỗi lần đồng bộ gần nhất; hoặc thông báo lỗi.&lt;br&gt;&lt;br&gt;&lt;b&gt;Thuật toán:&lt;/b&gt;&lt;br&gt;B1: Nhận D1 từ người dùng.&lt;br&gt;B2: Nhận D2 từ thiết bị nhập.&lt;br&gt;B3: Kết nối cơ sở dữ liệu.&lt;br&gt;B4: Đọc D3 từ bộ nhớ phụ.&lt;br&gt;B5: Webhook: kiểm tra đúng mã bí mật JIRA_WEBHOOK_SECRET và dự án đã được thêm vào hệ thống? Nếu không thỏa: ghi thông báo lỗi vào D6, chuyển tới B13.&lt;br&gt;B6: Xuất D5, nhận D2 qua Jira API; lỗi thì thử lại tối đa 2 lần, vẫn lỗi thì ghi nhật ký đồng bộ thất bại và không thay đổi dữ liệu.&lt;br&gt;B7: Với từng issue: chỉ ghi khi bản Jira mới hơn; nội dung đổi thì tạo phiên bản mới (như YC1).&lt;br&gt;B8: AC đổi hoặc bị bỏ: gắn cờ Cần xem lại cho test liên kết với AC đó. Tiêu đề hoặc mô tả đổi: gắn cờ mọi test của requirement.&lt;br&gt;B9: Requirement không còn trong kết quả (danh sách khác rỗng): hỏi Jira theo issue ID; 404 → &quot;Jira báo không tìm thấy&quot;, khác loại → &quot;Không còn thuộc loại được đồng bộ&quot;; gắn cờ Cần kiểm tra, không tự lưu trữ.&lt;br&gt;B10: Requirement Cần kiểm tra hoặc đã lưu trữ xuất hiện lại trên Jira thì tự gỡ cờ, tự hiện lại.&lt;br&gt;B11: Quyết định: kiểm tra người dùng là Admin hoặc QA Lead và requirement đang Cần kiểm tra? Lưu trữ → ẩn requirement, giữ test; Giữ lại → chỉ ghi nhận, cờ vẫn giữ.&lt;br&gt;B12: Lưu D4 xuống bộ nhớ phụ.&lt;br&gt;B13: Xuất D6 cho người dùng.&lt;br&gt;B14: Đóng kết nối cơ sở dữ liệu.&lt;br&gt;B15: Kết thúc." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Times New Roman;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="810" width="1520" height="700" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
