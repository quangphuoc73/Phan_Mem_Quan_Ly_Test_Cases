# Cấu hình cho bộ kiểm thử tự động Playwright (thư mục automation/).
# Sao chép thành .env rồi sửa giá trị:  cp .env.example .env
# File .env KHÔNG được commit lên GitHub (đã có trong .gitignore).
# Mọi biến đều có giá trị mặc định: không có .env vẫn chạy được với Sauce Demo.

# ---------- Ứng dụng cần test ----------
# URL gốc của web cần kiểm thử (page.goto('/') sẽ mở URL này)
BASE_URL=https://www.saucedemo.com/

# ---------- Tài khoản test ----------
# Chỉ dùng tài khoản TEST, không bao giờ dùng tài khoản thật của người dùng.
# Sauce Demo công khai các tài khoản dưới đây ngay trên trang đăng nhập.
TEST_USERNAME=standard_user
TEST_PASSWORD=secret_sauce
LOCKED_USERNAME=locked_out_user

# ---------- Trình duyệt ----------
# Để trống: dùng Google Chrome đã cài trên máy (không cần tải thêm trình duyệt)
# chromium: dùng Chromium của Playwright (Docker/CI; cần chạy: npx playwright install chromium)
PW_CHANNEL=
# 1 = mở cửa sổ trình duyệt khi chạy (xem trực tiếp lúc demo); để trống = chạy ngầm
HEADED=
# Làm chậm mỗi thao tác (mili giây) để người xem kịp theo dõi khi demo, ví dụ 300
SLOW_MO=0

# ---------- Thời gian chờ ----------
# Thời gian tối đa cho một test (mili giây)
TEST_TIMEOUT=30000
# Thời gian chờ cho mỗi expect (mili giây)
EXPECT_TIMEOUT=5000
# Số lần chạy lại khi test lỗi (nên để 0 khi viết test, 1–2 trên CI)
RETRIES=0
# Số worker chạy song song; để trống = Playwright tự chọn theo số CPU
WORKERS=

# ---------- Bằng chứng khi lỗi ----------
# 1 = quay video khi test lỗi (cần chạy trước: npx playwright install ffmpeg)
VIDEO=

# ---------- Chụp ảnh màn hình hệ thống (tools/screenshots.js) ----------
# URL của hệ thống AI TestCase Manager đang chạy
APP_URL=http://localhost:3000
