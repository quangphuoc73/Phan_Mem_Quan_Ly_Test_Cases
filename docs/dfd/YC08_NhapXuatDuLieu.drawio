y"/></mxCell><mxCell id="c14" value="" style="shape=singleArrow;direction=east;whiteSpace=wrap;html=1;arrowWidth=0.42;arrowSize=0.28;fillColor=#8C9524;strokeColor=#4D5214;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="990" y="410" width="168" height="50" as="geometry"/></mxCell><mxCell id="c15" value="D5" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1040" y="360" width="60" height="40" as="geometry"/></mxCell><mxCell id="c16" value="" style="shape=singleArrow;direction=north;whiteSpace=wrap;html=1;arrowWidth=0.42;arrowSize=0.28;fillColor=#8C9524;strokeColor=#4D5214;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="730" y="498" width="46" height="190" as="geometry"/></mxCell><mxCell id="c17" value="D3" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="660" y="575" width="60" height="40" as="geometry"/></mxCell><mxCell id="c18" value="" style="shape=singleArrow;direction=south;whiteSpace=wrap;html=1;arrowWidth=0.42;arrowSize=0.28;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="824" y="498" width="46" height="190" as="geometry"/></mxCell><mxCell id="c19" value="D4" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="880" y="575" width="60" height="40" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Biểu mẫu:&lt;/b&gt; BM8 &amp;nbsp; &lt;b&gt;Quy định:&lt;/b&gt; Không có&lt;br&gt;&lt;br&gt;&lt;b&gt;D1:&lt;/b&gt; Điều kiện lọc như YC7.&lt;br&gt;&lt;b&gt;D2:&lt;/b&gt; Không có&lt;br&gt;&lt;b&gt;D3:&lt;/b&gt; Các test case thỏa điều kiện kèm kết quả chạy gần nhất.&lt;br&gt;&lt;b&gt;D4:&lt;/b&gt; Không có&lt;br&gt;&lt;b&gt;D5:&lt;/b&gt; File Excel: mỗi test case một dòng theo các cột của BM2 và kết quả gần nhất (BM8).&lt;br&gt;&lt;b&gt;D6:&lt;/b&gt; Thông báo xuất file thành công (trình duyệt tải file về).&lt;br&gt;&lt;br&gt;&lt;b&gt;Thuật toán:&lt;/b&gt;&lt;br&gt;B1: Nhận D1 từ người dùng.&lt;br&gt;B2: Kết nối cơ sở dữ liệu.&lt;br&gt;B3: Đọc D3 từ bộ nhớ phụ.&lt;br&gt;B4: Ghi từng test case thành một dòng Excel; các bước, acceptance criteria xuống dòng trong ô.&lt;br&gt;B5: Xuất D5 ra thiết bị xuất.&lt;br&gt;B6: Xuất D6 cho người dùng.&lt;br&gt;B7: Đóng kết nối cơ sở dữ liệu.&lt;br&gt;B8: Kết thúc." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Times New Roman;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="810" width="1520" height="700" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
