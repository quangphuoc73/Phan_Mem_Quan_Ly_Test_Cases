ntStyle=1;" vertex="1" parent="1"><mxGeometry x="1040" y="360" width="60" height="40" as="geometry"/></mxCell><mxCell id="c16" value="" style="shape=singleArrow;direction=north;whiteSpace=wrap;html=1;arrowWidth=0.42;arrowSize=0.28;fillColor=#8C9524;strokeColor=#4D5214;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="730" y="498" width="46" height="190" as="geometry"/></mxCell><mxCell id="c17" value="D3" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="660" y="575" width="60" height="40" as="geometry"/></mxCell><mxCell id="c18" value="" style="shape=singleArrow;direction=south;whiteSpace=wrap;html=1;arrowWidth=0.42;arrowSize=0.28;fillColor=#8C9524;strokeColor=#4D5214;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="824" y="498" width="46" height="190" as="geometry"/></mxCell><mxCell id="c19" value="D4" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="880" y="575" width="60" height="40" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Biểu mẫu:&lt;/b&gt; BM7 &amp;nbsp; &lt;b&gt;Quy định:&lt;/b&gt; QĐ1, QĐ8&lt;br&gt;&lt;br&gt;&lt;b&gt;D1:&lt;/b&gt; Dự án nhận dữ liệu; lệnh chọn file.&lt;br&gt;&lt;b&gt;D2:&lt;/b&gt; Các dòng user story trong file (BM7).&lt;br&gt;&lt;b&gt;D3:&lt;/b&gt; Danh sách mã user story đã có; module của dự án; tham số MIN_AC_PER_STORY, PRIORITIES.&lt;br&gt;&lt;b&gt;D4:&lt;/b&gt; Các user story hợp lệ.&lt;br&gt;&lt;b&gt;D5:&lt;/b&gt; Không có&lt;br&gt;&lt;b&gt;D6:&lt;/b&gt; Thông báo số dòng nhập thành công và danh sách dòng lỗi kèm lý do.&lt;br&gt;&lt;br&gt;&lt;b&gt;Thuật toán:&lt;/b&gt;&lt;br&gt;B1: Nhận D1 từ người dùng.&lt;br&gt;B2: Nhận D2 từ thiết bị nhập.&lt;br&gt;B3: Kết nối cơ sở dữ liệu.&lt;br&gt;B4: Đọc D3 từ bộ nhớ phụ.&lt;br&gt;B5: Kiểm tra số dòng trong D2 ≤ 200? Nếu không thỏa: ghi thông báo lỗi vào D6, chuyển tới B8.&lt;br&gt;B6: Với từng dòng: kiểm tra theo QĐ1 như YC1; dòng lỗi được ghi lại số dòng và lý do, không làm hỏng các dòng hợp lệ.&lt;br&gt;B7: Lưu D4 xuống bộ nhớ phụ.&lt;br&gt;B8: Xuất D6 cho người dùng.&lt;br&gt;B9: Đóng kết nối cơ sở dữ liệu.&lt;br&gt;B10: Kết thúc." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Times New Roman;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="810" width="1520" height="700" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p2" name="DFD YC8b – Xuất test case ra Excel"><mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1500" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;DFD YC8b – Xuất test case ra Excel&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Times New Roman;fontSize=30;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1500" height="50" as="geometry"/></mxCell><mxCell id="c3" value="Người dùng" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1046A8;strokeColor=#000000;strokeWidth=3;fontFamily=Times New Roman;fontSize=26;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="590" y="90" width="420" height="90" as="geometry"/></mxCell><mxCell id="c4" value="Xuất test case ra Excel" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1046A8;strokeColor=#000000;strokeWidth=3;fontFamily=Times New Roman;fontSize=26;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="610" y="370" width="380" height="130" as="geometry"/></mxCell><mxCell id="c5" value="Thiết bị nhập" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1046A8;strokeColor=#000000;strokeWidth=3;fontFamily=Times New Roman;fontSize=26;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="390" width="420" height="90" as="geometry"/></mxCell><mxCell id="c6" value="File Excel (.xlsx)" style="rounded=0;whiteSpace=wrap;html