x="1" parent="1"><mxGeometry x="600" y="690" width="400" height="90" as="geometry"/></mxCell><mxCell id="c8" value="" style="shape=singleArrow;direction=south;whiteSpace=wrap;html=1;arrowWidth=0.42;arrowSize=0.28;fillColor=#8C9524;strokeColor=#4D5214;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="730" y="182" width="46" height="190" as="geometry"/></mxCell><mxCell id="c9" value="D1" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="660" y="255" width="60" height="40" as="geometry"/></mxCell><mxCell id="c10" value="" style="shape=singleArrow;direction=north;whiteSpace=wrap;html=1;arrowWidth=0.42;arrowSize=0.28;fillColor=#8C9524;strokeColor=#4D5214;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="824" y="182" width="46" height="190" as="geometry"/></mxCell><mxCell id="c11" value="D6" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="880" y="255" width="60" height="40" as="geometry"/></mxCell><mxCell id="c12" value="" style="shape=singleArrow;direction=east;whiteSpace=wrap;html=1;arrowWidth=0.42;arrowSize=0.28;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="445" y="410" width="168" height="50" as="geometry"/></mxCell><mxCell id="c13" value="D2" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="495" y="360" width="60" height="40" as="geometry"/></mxCell><mxCell id="c14" value="" style="shape=singleArrow;direction=east;whiteSpace=wrap;html=1;arrowWidth=0.42;arrowSize=0.28;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="990" y="410" width="168" height="50" as="geometry"/></mxCell><mxCell id="c15" value="D5" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1040" y="360" width="60" height="40" as="geometry"/></mxCell><mxCell id="c16" value="" style="shape=singleArrow;direction=north;whiteSpace=wrap;html=1;arrowWidth=0.42;arrowSize=0.28;fillColor=#8C9524;strokeColor=#4D5214;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="730" y="498" width="46" height="190" as="geometry"/></mxCell><mxCell id="c17" value="D3" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="660" y="575" width="60" height="40" as="geometry"/></mxCell><mxCell id="c18" value="" style="shape=singleArrow;direction=south;whiteSpace=wrap;html=1;arrowWidth=0.42;arrowSize=0.28;fillColor=#8C9524;strokeColor=#4D5214;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="824" y="498" width="46" height="190" as="geometry"/></mxCell><mxCell id="c19" value="D4" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="880" y="575" width="60" height="40" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Biểu mẫu:&lt;/b&gt; BM13 &amp;nbsp; &lt;b&gt;Quy định:&lt;/b&gt; QĐ14&lt;br&gt;&lt;br&gt;&lt;b&gt;D1:&lt;/b&gt; Thông tin đợt (BM13): dự án, tên, loại, build, môi trường, hạn; suite hoặc test được chọn; người được giao; hoặc thao tác sửa đợt, thêm/bỏ test, phân công lại, đóng đợt (kèm xác nhận).&lt;br&gt;&lt;b&gt;D2:&lt;/b&gt; Không có&lt;br&gt;&lt;b&gt;D3:&lt;/b&gt; Trạng thái, phiên bản, cờ của test; trạng thái lưu trữ, Cần kiểm tra của requirement; vai trò người được giao; các lần chạy đã có trong đợt.&lt;br&gt;&lt;b&gt;D4:&lt;/b&gt; Test Run; các test trong đợt với phiên bản cố định và người được giao; build, môi trường mới; trạng thái Đã đóng; nhật ký hoạt động.&lt;br&gt;&lt;b&gt;D5:&lt;/b&gt; Không có&lt;br&gt;&lt;b&gt;D6:&lt;/b&gt; Đợt vừa lập kèm danh sách test bị bỏ qua và lý do; tiến độ, cảnh báo (test có phiên bản mới, requirement đổi); hoặc thông báo lỗi vi phạm QĐ14.&lt;br&gt;&lt;br&gt;&lt;b&gt;Thuật toán:&lt;/b&gt;&lt;br&gt;B1: Nhận D1 từ người dùng.&lt;br&gt;B2: Kết nối cơ sở dữ liệu.&lt;br&gt;B3: Đọc D3 từ bộ nhớ phụ.&lt;br&gt;B4: Kiểm tra người dùng có vai trò QA Lead và đã nhập build, môi trường? Nếu không thỏa: ghi thông báo lỗi vào D6, chuyển tới B12.&lt;br&gt;B5: Kiểm tra người được giao là QA Lead hoặc Tester? Nếu không thỏa: ghi thông báo lỗi vào D6, chuyển tới B12.&lt;br&gt;B6: Với từng test: kiểm tra điều kiện chạy – Đã duyệt, không có cờ Cần xem lại, requirement không lưu trữ hoặc Cần kiểm tra. Test không đủ điều kiện bị bỏ qua kèm lý do. Kiểm tra còn ít nhất 1 test đủ điều kiện? Nếu không thỏa: ghi thông báo lỗi vào D6, chuyển tới B12.&lt;br&gt;B7: Cố định phiên bản hiện tại của từng test khi đưa vào đợt.&lt;br&gt;B8: Sửa build hoặc môi trường: kiểm tra đợt chưa có kết quả nào? Nếu không thỏa: ghi thông báo lỗi vào D6, chuyển tới B12.&lt;br&gt;B9: Bỏ test khỏi đợt: kiểm tra test chưa có kết quả trong đợt? Nếu không thỏa: ghi thông báo lỗi vào D6, chuyển tới B12.&lt;br&gt;B10: Đóng đợt: còn test chưa chạy thì kiểm tra người dùng đã xác nhận? Nếu không thỏa: ghi thông báo lỗi vào D6, chuyển tới B12.&lt;br&gt;B11: Lưu D4 xuống bộ nhớ phụ.&lt;br&gt;B12: Xuất D6 cho người dùng.&lt;br&gt;B13: Đóng kết nối cơ sở dữ liệu.&lt;br&gt;B14: Kết thúc." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Times New Roman;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="810" width="1520" height="700" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
