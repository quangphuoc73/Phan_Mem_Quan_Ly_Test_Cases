<mxfile host="generate_dfd.py" agent="SE104 AI TestCase Manager" version="24.0.0"><diagram id="p1" name="DFD YC1 – Xem requirement từ Jira và lịch sử thay đổi"><mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1500" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;DFD YC1 – Xem requirement từ Jira và lịch sử thay đổi&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Times New Roman;fontSize=30;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1500" height="50" as="geometry"/></mxCell><mxCell id="c3" value="Mọi vai trò (đồng bộ: Admin, QA Lead)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1046A8;strokeColor=#000000;strokeWidth=3;fontFamily=Times New Roman;fontSize=26;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="590" y="90" width="420" height="90" as="geometry"/></mxCell><mxCell id="c4" value="Đồng bộ, xem requirement" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1046A8;strokeColor=#000000;strokeWidth=3;fontFamily=Times New Roman;fontSize=26;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="610" y="370" width="380" height="130" as="geometry"/></mxCell><mxCell id="c5" value="Jira (REST API)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1046A8;strokeColor=#000000;strokeWidth=3;fontFamily=Times New Roman;fontSize=26;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="390" width="420" height="90" as="geometry"/></mxCell><mxCell id="c6" value="Jira (REST API)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1046A8;strokeColor=#000000;strokeWidth=3;fontFamily=Times New Roman;fontSize=26;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1160" y="390" width="420" height="90" as="geometry"/></mxCell><mxCell id="c7" value="Bộ nhớ phụ" style="shape=partialRectangle;whiteSpace=wrap;html=1;left=0;right=0;fillColor=none;strokeColor=#000000;strokeWidth=4;fontFamily=Times New Roman;fontSize=26;" vertex="1" parent="1"><mxGeometry x="600" y="690" width="400" height="90" as="geometry"/></mxCell><mxCell id="c8" value="" style="shape=singleArrow;direction=south;whiteSpace=wrap;html=1;arrowWidth=0.42;arrowSize=0.28;fillColor=#8C9524;strokeColor=#4D5214;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="730" y="182" width="46" height="190" as="geometry"/></mxCell><mxCell id="c9" value="D1" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="660" y="255" width="60" height="40" as="geometry"/></mxCell><mxCell id="c10" value="" style="shape=singleArrow;direction=north;whiteSpace=wrap;html=1;arrowWidth=0.42;arrowSize=0.28;fillColor=#8C9524;strokeColor=#4D5214;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="824" y="182" width="46" height="190" as="geometry"/></mxCell><mxCell id="c11" value="D6" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="880" y="255" width="60" height="40" as="geometry"/></mxCell><mxCell id="c12" value="" style="shape=singleArrow;direction=east;whiteSpace=wrap;html=1;arrowWidth=0.42;arrowSize=0.28;fillColor=#8C9524;strokeColor=#4D5214;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="445" y="410" width="168" height="50" as="geometry"/></mxCell><mxCell id="c13" value="D2" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="495" y="360" width="60" height="40" as="geometry"/></mxCell><mxCell id="c14" value="" style="shape=singleArrow;direction=east;whiteSpace=wrap;html=1;arrowWidth=0.42;arrowSize=0.28;fillColor=#8C9524;strokeColor=#4D5214;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="990" y="410" width="168" height="50" as="geometry"/></mxCell><mxCell id="c15" value="D5" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1040" y="360" width="60" height="40" as="geometry"/></mxCell><mxCell id="c16" value="" style="shape=singleArrow;direction=north;whiteSpace=wrap;html=1;arrowWidth=0.42;arrowSize=0.28;fillColor=#8C9524;strokeColor=#4D5214;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="730" y="498" width="46" height="190" as="geometry"/></mxCell><mxCell id="c17" value="D3" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="660" y="575" width="60" height="40" as="geometry"/></mxCell><mxCell id="c18" value="" style="shape=singleArrow;direction=south;whiteSpace=wrap;html=1;arrowWidth=0.42;arrowSize=0.28;fillColor=#8C9524;strokeColor=#4D5214;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="824" y="498" width="46" height="190" as="geometry"/></mxCell><mxCell id="c19" value="D4" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="880" y="575" width="60" height="40" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Biểu mẫu:&lt;/b&gt; BM1 &amp;nbsp; &lt;b&gt;Quy định:&lt;/b&gt; QĐ1&lt;br&gt;&lt;br&gt;&lt;b&gt;D1:&lt;/b&gt; Dự án cần đồng bộ (thao tác Đồng bộ ngay); hoặc requirement cần xem, phiên bản cần so sánh.&lt;br&gt;&lt;b&gt;D2:&lt;/b&gt; Từ Jira: các issue thuộc loại JIRA_ISSUE_TYPES của dự án – issue ID, mã, Summary, Description (có mục &quot;Acceptance criteria&quot;), Priority, loại issue, component, trạng thái, thời điểm cập nhật (updated).&lt;br&gt;&lt;b&gt;D3:&lt;/b&gt; Mã Jira của dự án; requirement đã có (theo issue ID) cùng thời điểm cập nhật Jira đã lưu và phiên bản hiện tại; module của dự án.&lt;br&gt;&lt;b&gt;D4:&lt;/b&gt; Requirement mới (BM1, phiên bản 1) hoặc cập nhật; phiên bản mới khi tiêu đề, mô tả hoặc AC đổi; nhật ký đồng bộ; nhật ký hoạt động.&lt;br&gt;&lt;b&gt;D5:&lt;/b&gt; Yêu cầu tìm issue theo loại của dự án gửi Jira REST API, kèm thông tin xác thực đọc từ .env.&lt;br&gt;&lt;b&gt;D6:&lt;/b&gt; Danh sách requirement kèm trạng thái đồng bộ (Bình thường, Thiếu AC, Cần kiểm tra, Đã lưu trữ); chi tiết, lịch sử phiên bản và so sánh trước/sau; hoặc thông báo lỗi.&lt;br&gt;&lt;br&gt;&lt;b&gt;Thuật toán:&lt;/b&gt;&lt;br&gt;B1: Nhận D1 từ người dùng.&lt;br&gt;B2: Kết nối cơ sở dữ liệu.&lt;br&gt;B3: Đọc D3 từ bộ nhớ phụ.&lt;br&gt;B4: Đồng bộ: kiểm tra người dùng có vai trò Admin hoặc QA Lead và dự án đã liên kết Jira? Nếu không thỏa: ghi thông báo lỗi vào D6, chuyển tới B11.&lt;br&gt;B5: Xuất D5 đến Jira, nhận D2 (lấy hết các trang); lỗi kết nối thì thử lại tối đa 2 lần.&lt;br&gt;B6: Với từng issue: nhận diện requirement bằng issue ID; chỉ ghi khi thời điểm cập nhật trên Jira mới hơn bản đã lưu.&lt;br&gt;B7: Tách Description: phần trước nhãn &quot;Acceptance criteria&quot; là mô tả, mỗi dòng sau là một AC; đổi Priority về High / Medium / Low.&lt;br&gt;B8: Tiêu đề, mô tả hoặc AC đổi thì tạo phiên bản mới, không xóa phiên bản cũ; đổi ưu tiên, trạng thái Jira chỉ cập nhật giá trị hiện tại.&lt;br&gt;B9: Requirement không có AC được đánh dấu Thiếu AC.&lt;br&gt;B10: Lưu D4 xuống bộ nhớ phụ.&lt;br&gt;B11: Xuất D6 cho người dùng.&lt;br&gt;B12: Đóng kết nối cơ sở dữ liệu.&lt;br&gt;B13: Kết thúc." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Times New Roman;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="810" width="1520" height="700" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
