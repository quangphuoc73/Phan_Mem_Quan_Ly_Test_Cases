<mxfile host="generate_dfd.py" agent="SE104 AI TestCase Manager" version="24.0.0"><diagram id="p1" name="DFD YC8 – Nhận thay đổi user story từ Jira"><mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1500" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;DFD YC8 – Nhận thay đổi user story từ Jira&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Times New Roman;fontSize=30;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1500" height="50" as="geometry"/></mxCell><mxCell id="c3" value="Tester, QA Lead" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1046A8;strokeColor=#000000;strokeWidth=3;fontFamily=Times New Roman;fontSize=26;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="590" y="90" width="420" height="90" as="geometry"/></mxCell><mxCell id="c4" value="Nhận thay đổi user story" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1046A8;strokeColor=#000000;strokeWidth=3;fontFamily=Times New Roman;fontSize=26;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="610" y="370" width="380" height="130" as="geometry"/></mxCell><mxCell id="c5" value="Jira (webhook)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1046A8;strokeColor=#000000;strokeWidth=3;fontFamily=Times New Roman;fontSize=26;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="390" width="420" height="90" as="geometry"/></mxCell><mxCell id="c6" value="Thiết bị xuất" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1046A8;strokeColor=#000000;strokeWidth=3;fontFamily=Times New Roman;fontSize=26;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1160" y="390" width="420" height="90" as="geometry"/></mxCell><mxCell id="c7" value="Bộ nhớ phụ" style="shape=partialRectangle;whiteSpace=wrap;html=1;left=0;right=0;fillColor=none;strokeColor=#000000;strokeWidth=4;fontFamily=Times New Roman;fontSize=26;" vertex="1" parent="1"><mxGeometry x="600" y="690" width="400" height="90" as="geometry"/></mxCell><mxCell id="c8" value="" style="shape=singleArrow;direction=south;whiteSpace=wrap;html=1;arrowWidth=0.42;arrowSize=0.28;fillColor=#8C9524;strokeColor=#4D5214;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="730" y="182" width="46" height="190" as="geometry"/></mxCell><mxCell id="c9" value="D1" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="660" y="255" width="60" height="40" as="geometry"/></mxCell><mxCell id="c10" value="" style="shape=singleArrow;direction=north;whiteSpace=wrap;html=1;arrowWidth=0.42;arrowSize=0.28;fillColor=#8C9524;strokeColor=#4D5214;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="824" y="182" width="46" height="190" as="geometry"/></mxCell><mxCell id="c11" value="D6" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="880" y="255" width="60" height="40" as="geometry"/></mxCell><mxCell id="c12" value="" style="shape=singleArrow;direction=east;whiteSpace=wrap;html=1;arrowWidth=0.42;arrowSize=0.28;fillColor=#8C9524;strokeColor=#4D5214;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="445" y="410" width="168" height="50" as="geometry"/></mxCell><mxCell id="c13" value="D2" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="495" y="360" width="60" height="40" as="geometry"/></mxCell><mxCell id="c14" value="" style="shape=singleArrow;direction=east;whiteSpace=wrap;html=1;arrowWidth=0.42;arrowSize=0.28;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="990" y="410" width="168" height="50" as="geometry"/></mxCell><mxCell id="c15" value="D5" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1040" y="360" width="60" height="40" as="geometry"/></mxCell><mxCell id="c16" value="" style="shape=singleArrow;direction=north;whiteSpace=wrap;html=1;arrowWidth=0.42;arrowSize=0.28;fillColor=#8C9524;strokeColor=#4D5214;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="730" y="498" width="46" height="190" as="geometry"/></mxCell><mxCell id="c17" value="D3" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="660" y="575" width="60" height="40" as="geometry"/></mxCell><mxCell id="c18" value="" style="shape=singleArrow;direction=south;whiteSpace=wrap;html=1;arrowWidth=0.42;arrowSize=0.28;fillColor=#8C9524;strokeColor=#4D5214;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="824" y="498" width="46" height="190" as="geometry"/></mxCell><mxCell id="c19" value="D4" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="880" y="575" width="60" height="40" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Biểu mẫu:&lt;/b&gt; BM7 &amp;nbsp; &lt;b&gt;Quy định:&lt;/b&gt; QĐ8&lt;br&gt;&lt;br&gt;&lt;b&gt;D1:&lt;/b&gt; Thao tác Đã xem lại test case của một story (khi Tester xem xong).&lt;br&gt;&lt;b&gt;D2:&lt;/b&gt; Từ Jira: sự kiện webhook (issue tạo / sửa / xóa) kèm mã dự án và mã bí mật; hoặc lượt đồng bộ định kỳ.&lt;br&gt;&lt;b&gt;D3:&lt;/b&gt; Mã bí mật JIRA_WEBHOOK_SECRET; nội dung cũ của story (tiêu đề, mô tả, acceptance criteria); số test case của story; danh sách story của dự án.&lt;br&gt;&lt;b&gt;D4:&lt;/b&gt; Nội dung mới của story; thời điểm cần xem lại test case (BM7); cờ lưu trữ của story không còn trên Jira; nhật ký hoạt động.&lt;br&gt;&lt;b&gt;D5:&lt;/b&gt; Không có&lt;br&gt;&lt;b&gt;D6:&lt;/b&gt; Tester thấy nhãn &quot;Cần xem lại test case&quot; hoặc &quot;Đã xóa trên Jira&quot; trên story; thông báo đã xem lại; hoặc lỗi sai mã bí mật.&lt;br&gt;&lt;br&gt;&lt;b&gt;Thuật toán:&lt;/b&gt;&lt;br&gt;B1: Nhận D1 từ người dùng.&lt;br&gt;B2: Nhận D2 từ thiết bị nhập.&lt;br&gt;B3: Kết nối cơ sở dữ liệu.&lt;br&gt;B4: Đọc D3 từ bộ nhớ phụ.&lt;br&gt;B5: Kiểm tra mã bí mật của webhook đúng JIRA_WEBHOOK_SECRET? Nếu không thỏa: ghi thông báo lỗi vào D6, chuyển tới B12.&lt;br&gt;B6: Kiểm tra dự án của issue đã được thêm vào hệ thống (chưa có thì bỏ qua sự kiện)? Nếu không thỏa: ghi thông báo lỗi vào D6, chuyển tới B12.&lt;br&gt;B7: Đồng bộ lại user story của dự án như YC1.&lt;br&gt;B8: So nội dung mới với D3: tiêu đề, mô tả hoặc acceptance criteria đổi mà story đã có test case thì ghi thời điểm cần xem lại.&lt;br&gt;B9: Story có trong D3 mà không còn trên Jira thì đánh dấu lưu trữ, giữ test case; story xuất hiện lại thì bỏ lưu trữ.&lt;br&gt;B10: Khi Tester bấm Đã xem lại: nếu story đang có đánh dấu cần xem lại thì xóa đánh dấu, ngược lại báo lỗi.&lt;br&gt;B11: Lưu D4 xuống bộ nhớ phụ.&lt;br&gt;B12: Xuất D6 cho người dùng.&lt;br&gt;B13: Đóng kết nối cơ sở dữ liệu.&lt;br&gt;B14: Kết thúc." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Times New Roman;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="810" width="1520" height="700" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
