ex="1" parent="1"><mxGeometry x="600" y="690" width="400" height="90" as="geometry"/></mxCell><mxCell id="c8" value="" style="shape=singleArrow;direction=south;whiteSpace=wrap;html=1;arrowWidth=0.42;arrowSize=0.28;fillColor=#8C9524;strokeColor=#4D5214;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="730" y="182" width="46" height="190" as="geometry"/></mxCell><mxCell id="c9" value="D1" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="660" y="255" width="60" height="40" as="geometry"/></mxCell><mxCell id="c10" value="" style="shape=singleArrow;direction=north;whiteSpace=wrap;html=1;arrowWidth=0.42;arrowSize=0.28;fillColor=#8C9524;strokeColor=#4D5214;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="824" y="182" width="46" height="190" as="geometry"/></mxCell><mxCell id="c11" value="D6" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="880" y="255" width="60" height="40" as="geometry"/></mxCell><mxCell id="c12" value="" style="shape=singleArrow;direction=east;whiteSpace=wrap;html=1;arrowWidth=0.42;arrowSize=0.28;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="445" y="410" width="168" height="50" as="geometry"/></mxCell><mxCell id="c13" value="D2" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="495" y="360" width="60" height="40" as="geometry"/></mxCell><mxCell id="c14" value="" style="shape=singleArrow;direction=east;whiteSpace=wrap;html=1;arrowWidth=0.42;arrowSize=0.28;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="990" y="410" width="168" height="50" as="geometry"/></mxCell><mxCell id="c15" value="D5" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1040" y="360" width="60" height="40" as="geometry"/></mxCell><mxCell id="c16" value="" style="shape=singleArrow;direction=north;whiteSpace=wrap;html=1;arrowWidth=0.42;arrowSize=0.28;fillColor=#8C9524;strokeColor=#4D5214;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="730" y="498" width="46" height="190" as="geometry"/></mxCell><mxCell id="c17" value="D3" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="660" y="575" width="60" height="40" as="geometry"/></mxCell><mxCell id="c18" value="" style="shape=singleArrow;direction=south;whiteSpace=wrap;html=1;arrowWidth=0.42;arrowSize=0.28;fillColor=#8C9524;strokeColor=#4D5214;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="824" y="498" width="46" height="190" as="geometry"/></mxCell><mxCell id="c19" value="D4" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="880" y="575" width="60" height="40" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Biểu mẫu:&lt;/b&gt; BM4 &amp;nbsp; &lt;b&gt;Quy định:&lt;/b&gt; QĐ5, QĐ18&lt;br&gt;&lt;br&gt;&lt;b&gt;D1:&lt;/b&gt; Test trong Test Run, kết quả Pass / Fail / Blocked, ghi chú, mã defect, liên kết bằng chứng (BM4).&lt;br&gt;&lt;b&gt;D2:&lt;/b&gt; Không có&lt;br&gt;&lt;b&gt;D3:&lt;/b&gt; Test Run (trạng thái, build, môi trường); test trong đợt (phiên bản cố định, người được giao); phiếu báo sửa đang chờ của test.&lt;br&gt;&lt;b&gt;D4:&lt;/b&gt; Lần chạy: kết quả, phiên bản test đã cố định, ghi chú, mã defect, bằng chứng, người chạy, thời điểm, lần Fail gốc (nếu là kiểm thử lại); trạng thái kiểm thử lại của phiếu báo sửa.&lt;br&gt;&lt;b&gt;D5:&lt;/b&gt; Không có&lt;br&gt;&lt;b&gt;D6:&lt;/b&gt; Thông báo ghi nhận thành công kèm cảnh báo (VD build khác build đã báo sửa), hoặc thông báo lỗi vi phạm QĐ5.&lt;br&gt;&lt;br&gt;&lt;b&gt;Thuật toán:&lt;/b&gt;&lt;br&gt;B1: Nhận D1 từ người dùng.&lt;br&gt;B2: Kết nối cơ sở dữ liệu.&lt;br&gt;B3: Đọc D3 từ bộ nhớ phụ.&lt;br&gt;B4: Kiểm tra Test Run đang mở? Nếu không thỏa: ghi thông báo lỗi vào D6, chuyển tới B9.&lt;br&gt;B5: Kiểm tra người ghi là người được giao hoặc QA Lead? Nếu không thỏa: ghi thông báo lỗi vào D6, chuyển tới B9.&lt;br&gt;B6: Nếu kết quả là Fail hoặc Blocked: kiểm tra có ghi chú? Bằng chứng (nếu có) là đường dẫn? Nếu không thỏa: ghi thông báo lỗi vào D6, chuyển tới B9.&lt;br&gt;B7: Nếu test đang chờ kiểm thử lại: gắn lần chạy với lần Fail gốc; Pass → Đã đóng, Fail → Mở lại, Blocked → vẫn chờ; build khác thì cảnh báo.&lt;br&gt;B8: Lưu D4 xuống bộ nhớ phụ.&lt;br&gt;B9: Xuất D6 cho người dùng.&lt;br&gt;B10: Đóng kết nối cơ sở dữ liệu.&lt;br&gt;B11: Kết thúc." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Times New Roman;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="810" width="1520" height="700" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
