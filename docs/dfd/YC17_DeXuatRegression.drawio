vertex="1" parent="1"><mxGeometry x="600" y="690" width="400" height="90" as="geometry"/></mxCell><mxCell id="c8" value="" style="shape=singleArrow;direction=south;whiteSpace=wrap;html=1;arrowWidth=0.42;arrowSize=0.28;fillColor=#8C9524;strokeColor=#4D5214;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="730" y="182" width="46" height="190" as="geometry"/></mxCell><mxCell id="c9" value="D1" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="660" y="255" width="60" height="40" as="geometry"/></mxCell><mxCell id="c10" value="" style="shape=singleArrow;direction=north;whiteSpace=wrap;html=1;arrowWidth=0.42;arrowSize=0.28;fillColor=#8C9524;strokeColor=#4D5214;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="824" y="182" width="46" height="190" as="geometry"/></mxCell><mxCell id="c11" value="D6" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="880" y="255" width="60" height="40" as="geometry"/></mxCell><mxCell id="c12" value="" style="shape=singleArrow;direction=east;whiteSpace=wrap;html=1;arrowWidth=0.42;arrowSize=0.28;fillColor=#8C9524;strokeColor=#4D5214;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="445" y="410" width="168" height="50" as="geometry"/></mxCell><mxCell id="c13" value="D2" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="495" y="360" width="60" height="40" as="geometry"/></mxCell><mxCell id="c14" value="" style="shape=singleArrow;direction=east;whiteSpace=wrap;html=1;arrowWidth=0.42;arrowSize=0.28;fillColor=#8C9524;strokeColor=#4D5214;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="990" y="410" width="168" height="50" as="geometry"/></mxCell><mxCell id="c15" value="D5" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1040" y="360" width="60" height="40" as="geometry"/></mxCell><mxCell id="c16" value="" style="shape=singleArrow;direction=north;whiteSpace=wrap;html=1;arrowWidth=0.42;arrowSize=0.28;fillColor=#8C9524;strokeColor=#4D5214;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="730" y="498" width="46" height="190" as="geometry"/></mxCell><mxCell id="c17" value="D3" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="660" y="575" width="60" height="40" as="geometry"/></mxCell><mxCell id="c18" value="" style="shape=singleArrow;direction=south;whiteSpace=wrap;html=1;arrowWidth=0.42;arrowSize=0.28;fillColor=#8C9524;strokeColor=#4D5214;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="824" y="498" width="46" height="190" as="geometry"/></mxCell><mxCell id="c19" value="D4" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="880" y="575" width="60" height="40" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Biểu mẫu:&lt;/b&gt; BM16 &amp;nbsp; &lt;b&gt;Quy định:&lt;/b&gt; QĐ17&lt;br&gt;&lt;br&gt;&lt;b&gt;D1:&lt;/b&gt; Requirement đã đổi; test cần thêm, bỏ (kèm lý do); thao tác xác nhận kèm tên đợt, build, môi trường, người được giao.&lt;br&gt;&lt;b&gt;D2:&lt;/b&gt; Chuỗi JSON: mức ưu tiên và lý do cho từng test, các test gợi ý thêm.&lt;br&gt;&lt;b&gt;D3:&lt;/b&gt; Hai phiên bản requirement của thay đổi; test liên kết với AC đã đổi (hoặc mọi test nếu tiêu đề, mô tả đổi); test đã duyệt khác của dự án; điều kiện chạy của từng test.&lt;br&gt;&lt;b&gt;D4:&lt;/b&gt; Bộ regression (Nháp / Đã xác nhận) và từng test: ưu tiên, lý do, nguồn, bắt buộc, đã bỏ, lý do bỏ; Test Run loại Regression khi xác nhận; nhật ký AI.&lt;br&gt;&lt;b&gt;D5:&lt;/b&gt; Prompt gửi LLM: requirement hiện tại, các test bắt buộc và test ứng viên, ĐÃ CHE dữ liệu nhạy cảm.&lt;br&gt;&lt;b&gt;D6:&lt;/b&gt; Bộ regression (BM16) kèm danh sách test chưa đủ điều kiện chạy; Test Run vừa tạo; hoặc thông báo lỗi vi phạm QĐ17.&lt;br&gt;&lt;br&gt;&lt;b&gt;Thuật toán:&lt;/b&gt;&lt;br&gt;B1: Nhận D1 từ người dùng.&lt;br&gt;B2: Kết nối cơ sở dữ liệu.&lt;br&gt;B3: Đọc D3 từ bộ nhớ phụ.&lt;br&gt;B4: Lập bộ: kiểm tra số lần gọi AI trong 1 giờ &amp;lt; AI_CALLS_PER_HOUR và requirement có thay đổi chưa có bộ regression được xác nhận? Nếu không thỏa: ghi thông báo lỗi vào D6, chuyển tới B11.&lt;br&gt;B5: Lấy phần bắt buộc: test liên kết với AC đã đổi; tiêu đề hoặc mô tả đổi thì mọi test của requirement.&lt;br&gt;B6: Xuất D5 đến LLM, nhận D2 (xếp ưu tiên, gợi ý thêm). Không gọi được AI thì vẫn đưa ra danh sách test liên kết.&lt;br&gt;B7: Bỏ test thuộc phần bắt buộc: kiểm tra có lý do? Nếu không thỏa: ghi thông báo lỗi vào D6, chuyển tới B11.&lt;br&gt;B8: Xác nhận: kiểm tra người dùng là QA Lead và không còn test chưa đủ điều kiện chạy trong bộ (QĐ14)? Nếu không thỏa: ghi thông báo lỗi vào D6, chuyển tới B11.&lt;br&gt;B9: Tạo Test Run loại Regression theo YC14 với các test còn trong bộ.&lt;br&gt;B10: Lưu D4 xuống bộ nhớ phụ.&lt;br&gt;B11: Xuất D6 cho người dùng.&lt;br&gt;B12: Đóng kết nối cơ sở dữ liệu.&lt;br&gt;B13: Kết thúc." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Times New Roman;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="810" width="1520" height="700" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
