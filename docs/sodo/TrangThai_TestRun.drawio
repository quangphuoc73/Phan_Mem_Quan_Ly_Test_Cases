<mxfile host="generate_hientrang.py" agent="SE104 AI TestCase Manager" version="24.0.0"><diagram id="p1" name="Sơ đồ trạng thái của Test Run"><mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1150" pageHeight="600" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;Sơ đồ trạng thái của Test Run (đợt kiểm thử)&lt;/b&gt;" style="text;html=1;align=left;fontFamily=Times New Roman;fontSize=26;" vertex="1" parent="1"><mxGeometry x="30" y="16" width="1200" height="36" as="geometry"/></mxCell><mxCell id="c3" value="" style="ellipse;fillColor=#000000;strokeColor=none;html=1;" vertex="1" parent="1"><mxGeometry x="201" y="81" width="28" height="28" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Đang mở – chưa có kết quả&lt;/b&gt;&lt;br&gt;sửa được build, môi trường;&lt;br&gt;thêm, bỏ test; phân công" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ECECFF;strokeColor=#9370DB;strokeWidth=2;fontFamily=Times New Roman;fontSize=19;fontColor=#000000;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="310" height="120" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Đang mở – đã có kết quả&lt;/b&gt;&lt;br&gt;build, môi trường cố định;&lt;br&gt;chỉ bỏ test chưa có kết quả" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;strokeWidth=2;fontFamily=Times New Roman;fontSize=19;fontColor=#000000;align=center;" vertex="1" parent="1"><mxGeometry x="420" y="150" width="310" height="120" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Đã đóng&lt;/b&gt;&lt;br&gt;không ghi thêm kết quả;&lt;br&gt;test chưa chạy tính chưa chạy" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#757575;strokeWidth=2;fontFamily=Times New Roman;fontSize=19;fontColor=#000000;align=center;" vertex="1" parent="1"><mxGeometry x="780" y="150" width="310" height="120" as="geometry"/></mxCell><mxCell id="c7" value="" style="ellipse;shape=endState;fillColor=#000000;strokeColor=#000000;html=1;" vertex="1" parent="1"><mxGeometry x="921" y="346" width="28" height="28" as="geometry"/></mxCell><mxCell id="c8" value="" style="edgeStyle=none;html=1;rounded=0;strokeWidth=2;strokeColor=#333333;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="215.0" y="109" as="sourcePoint"/><mxPoint x="215.0" y="150" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="c9" value="Lập đợt" style="text;html=1;align=center;verticalAlign=middle;labelBackgroundColor=#FFFFFF;fontFamily=Times New Roman;fontSize=17;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="114" y="109" width="72" height="26" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=none;html=1;rounded=0;strokeWidth=2;strokeColor=#333333;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="370" y="210.0" as="sourcePoint"/><mxPoint x="420" y="210.0" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="c11" value="Ghi kết quả&lt;br&gt;đầu tiên" style="text;html=1;align=center;verticalAlign=middle;labelBackgroundColor=#FFFFFF;fontFamily=Times New Roman;fontSize=17;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="337" y="102" width="106" height="47" as="geometry"/></mxCell><mxCell id="c12" value="" style="edgeStyle=none;html=1;rounded=0;strokeWidth=2;strokeColor=#333333;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="730" y="210.0" as="sourcePoint"/><mxPoint x="780" y="210.0" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="c13" value="Đóng đợt&lt;br&gt;[xác nhận nếu&lt;br&gt;còn test chưa chạy]" style="text;html=1;align=center;verticalAlign=middle;labelBackgroundColor=#FFFFFF;fontFamily=Times New Roman;fontSize=16;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="668" y="78" width="164" height="64" as="geometry"/></mxCell><mxCell id="c14" value="" style="edgeStyle=none;html=1;rounded=0;strokeWidth=2;strokeColor=#333333;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="215.0" y="270" as="sourcePoint"/><mxPoint x="840" y="270" as="targetPoint"/><Array as="points"><mxPoint x="215" y="330"/><mxPoint x="840" y="330"/></Array></mxGeometry></mxCell><mxCell id="c15" value="Đóng đợt [xác nhận]" style="text;html=1;align=center;verticalAlign=middle;labelBackgroundColor=#FFFFFF;fontFamily=Times New Roman;fontSize=17;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="433" y="301" width="174" height="26" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=none;html=1;rounded=0;strokeWidth=2;strokeColor=#333333;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="575" y="270" as="sourcePoint"/><mxPoint x="635" y="270" as="targetPoint"/><Array as="points"><mxPoint x="575" y="300"/><mxPoint x="635" y="300"/></Array></mxGeometry></mxCell><mxCell id="c17" value="Ghi thêm kết quả" style="text;html=1;align=left;verticalAlign=middle;fontStyle=2;fontFamily=Times New Roman;fontSize=16;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="690" y="277" width="140" height="25" as="geometry"/></mxCell><mxCell id="c18" value="" style="edgeStyle=none;html=1;rounded=0;strokeWidth=2;strokeColor=#333333;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="935.0" y="270" as="sourcePoint"/><mxPoint x="935.0" y="346" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="c19" value="Muốn chạy build hoặc môi trường khác thì lập đợt mới (D3). Requirement đổi, lưu trữ hoặc Cần kiểm tra&lt;br&gt;khi đợt đang mở thì đợt vẫn chạy phiên bản test đã cố định và hiện cảnh báo (QĐ14)." style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#FFFDE