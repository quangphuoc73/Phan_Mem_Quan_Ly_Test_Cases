<mxfile host="generate_hientrang.py" agent="SE104 AI TestCase Manager" version="24.0.0"><diagram id="p1" name="Sơ đồ lớp – tích hợp Jira"><mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1130" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;Sơ đồ lớp – tích hợp Jira một chiều (Jira → hệ thống)&lt;/b&gt;" style="text;html=1;align=left;fontFamily=Times New Roman;fontSize=26;" vertex="1" parent="1"><mxGeometry x="30" y="16" width="1200" height="36" as="geometry"/></mxCell><mxCell id="c3" value="&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;i&gt;«route»&lt;/i&gt;&lt;br&gt;&lt;b&gt;AdminRoutes&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0;margin-left:6px;&quot;&gt;&amp;nbsp;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0;margin-left:6px;&quot;&gt;GET /jira/info&lt;br&gt;POST /jira/test  (jira:connect)&lt;br&gt;POST /jira/import  (jira:import)&lt;br&gt;POST /projects/:id/jira-sync&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#ECECFF;strokeColor=#9370DB;strokeWidth=2;fontFamily=Times New Roman;fontSize=18;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="560" height="194" as="geometry"/></mxCell><mxCell id="c4" value="&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;i&gt;«route»&lt;/i&gt;&lt;br&gt;&lt;b&gt;WebhookRoute&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0;margin-left:6px;&quot;&gt;&amp;nbsp;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0;margin-left:6px;&quot;&gt;POST /api/jira/webhook?secret=…&lt;br&gt;(không qua JWT)&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#FDECEA;strokeColor=#E53935;strokeWidth=2;fontFamily=Times New Roman;fontSize=18;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="30" y="320" width="560" height="142" as="geometry"/></mxCell><mxCell id="c5" value="&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;i&gt;«server.js»&lt;/i&gt;&lt;br&gt;&lt;b&gt;Scheduler&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0;margin-left:6px;&quot;&gt;JIRA_SYNC_MINUTES = 5&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0;margin-left:6px;&quot;&gt;setInterval(syncAll)&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#ECECFF;strokeColor=#9370DB;strokeWidth=2;fontFamily=Times New Roman;fontSize=18;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="30" y="500" width="560" height="116" as="geometry"/></mxCell><mxCell id="c6" value="&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;i&gt;«hệ thống ngoài»&lt;/i&gt;&lt;br&gt;&lt;b&gt;JiraCloud&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0;margin-left:6px;&quot;&gt;REST v3: /project, /search/jql, /field&lt;br&gt;Agile: /board, /board/{id}/sprint&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0;margin-left:6px;&quot;&gt;webhook: jira:issue_*, sprint_*&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#E3F0FF;strokeColor=#0052CC;strokeWidth=2;fontFamily=Times New Roman;fontSize=18;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="640" y="80" width="530" height="142" as="geometry"/></mxCell><mxCell id="c7" value="&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;i&gt;«service»&lt;/i&gt;&lt;br&gt;&lt;b&gt;JiraService&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0;margin-left:6px;&quot;&gt;-config.jira: baseUrl, email, apiToken&lt;br&gt;-MOCK_PROJECTS (Jira giả lập)&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0;margin-left:6px;&quot;&gt;+tes